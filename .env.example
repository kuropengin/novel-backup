# docker compose 用。cp .env.example .env して値を設定する(.env は git 管理外)

# 初回管理者作成に必要なトークン。十分長いランダム文字列にする(例: openssl rand -base64 24)
# 管理者を作成したあとは空にしてよい
SETUP_TOKEN=

# X-Forwarded-For を信用する接続元。既定 uniquelocal(プライベート IP = proxy_web 上の nginx)。
# 絞る場合は nginx コンテナの IP を指定する(docker network inspect proxy_web で確認)
# TRUST_PROXY=172.18.0.2

# バックアップ設定(アプリの設定画面で変更した値が優先される)
BACKUP_FREQUENCY=hourly
BACKUP_TIME=03:00
BACKUP_MAX_PARALLEL=5

# スクレイパー(scrapling)の日次自動更新。既定は有効。false で無効(イメージ同梱の版だけを使う)
# SCRAPLING_AUTO_UPDATE=true
# 更新を確認する時刻 HH:mm(コンテナの TZ。既定 04:00)
# SCRAPLING_UPDATE_TIME=04:00
# サーバーIPがサイト側で 403 になる場合に使う固定 proxy (例: http://user:pass@host:port)
# SCRAPLING_PROXY=
