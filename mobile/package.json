    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/status-bar": "^8.0.4",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "typescript": "~6.0.3",
